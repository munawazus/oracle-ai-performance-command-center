# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (used by docker-compose to create the container, and by backend to connect) ---
POSTGRES_USER=ocmd
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=ocmd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://ocmd:change_me_dev_only@postgres:5432/ocmd
REDIS_URL=redis://redis:6379/0

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_a_real_secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Fernet key used by the local encrypted SecretProvider. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=change_me_generate_a_fernet_key

CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Scheduled Oracle collector (app/collectors/scheduler.py). Set to false to disable polling
# entirely (the backend test suite always overrides this to false regardless).
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=15

# Notification queue processor interval, and the base URL the "review this incident" link
# in alert emails points at (should be wherever the frontend is actually reachable).
NOTIFICATION_INTERVAL_SECONDS=10
FRONTEND_BASE_URL=http://localhost:5173

# AI gateway (app/ai/gateway.py) - off by default, no local model is assumed to exist.
# AI_BASE_URL must be an OpenAI-compatible endpoint (vLLM/Ollama/llama.cpp all work).
AI_ENABLED=false
AI_BASE_URL=http://localhost:8080/v1
AI_API_KEY=not-needed
AI_PRIMARY_MODEL=gpt-oss-120b
AI_FALLBACK_MODEL=gpt-oss-20b
AI_REQUEST_TIMEOUT_SECONDS=30

# Used only by scripts/seed.py to create the first ADMIN account. Not read at runtime.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change_me_dev_only

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
